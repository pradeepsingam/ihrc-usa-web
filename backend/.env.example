APP_NAME="IHRC-USA Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# For shared hosting with a separate frontend web root, store public uploads there.
# PUBLIC_STORAGE_PATH=/home/account/ihrc-usa.org/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Email (hosting SMTP) --------------------------------------------------
# Used for: form emails to the mailboxes, confirmations to applicants, password
# reset and newsletters. Take the values from your hosting control panel
# (cPanel → Email Accounts → "Connect Devices" / "Mail client configuration").
# Usually: host mail.ihrc-usa.org, port 465 with MAIL_SCHEME=smtps
# (or port 587 with MAIL_SCHEME=smtp). The username is the full mailbox address.
# The "from" address must be that same mailbox, or your host may reject the email.
# Check it works with:  php artisan mail:test you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.ihrc-usa.org
MAIL_PORT=465
MAIL_USERNAME=info@ihrc-usa.org
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@ihrc-usa.org"
MAIL_FROM_NAME="IHRC-USA"
MAIL_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
FRONTEND_URLS=*
FORMS_NOTIFY_EMAIL=
